<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_timer_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Vertical / Square layout (2x2 and taller) -->
    <LinearLayout
        android:id="@+id/widget_timer_vertical_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/widget_timer_open_area_v"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_timer_icon_v"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_timer_phase_img_v"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginStart="6dp"
                    android:scaleType="fitStart"
                    android:contentDescription="@string/widget_timer_label" />
            </LinearLayout>

            <Chronometer
                android:id="@+id/widget_timer_chronometer_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_timer_static_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="25:00"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_timer_toggle_btn_v"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_timer_toggle_desc">

                <ImageView
                    android:id="@+id/widget_timer_toggle_bg_v"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:id="@+id/widget_timer_toggle_icon_v"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_timer_toggle_text_v"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Start"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/widget_timer_reset_btn_v"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/widget_timer_reset_desc">

                <ImageView
                    android:id="@+id/widget_timer_reset_bg_v"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/widget_timer_reset_icon_v"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal compact layout (4x1 strip) -->
    <LinearLayout
        android:id="@+id/widget_timer_horizontal_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_timer_open_area_h"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_timer_icon_h"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_timer_phase_img_h"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:scaleType="fitStart"
                    android:contentDescription="@string/widget_timer_label" />

                <Chronometer
                    android:id="@+id/widget_timer_chronometer_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_timer_static_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25:00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_timer_toggle_btn_h"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="84dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/widget_timer_toggle_desc">

            <ImageView
                android:id="@+id/widget_timer_toggle_bg_h"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/widget_timer_toggle_icon_h"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_timer_toggle_text_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Start"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_timer_reset_btn_h"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/widget_timer_reset_desc">

            <ImageView
                android:id="@+id/widget_timer_reset_bg_h"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_timer_reset_icon_h"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>

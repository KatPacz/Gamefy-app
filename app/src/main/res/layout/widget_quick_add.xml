<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_add_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/widget_quick_add_desc">

    <ImageView
        android:id="@+id/widget_quick_add_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/widget_quick_add_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_quick_add_label" />

        <ImageView
            android:id="@+id/widget_quick_add_label_img"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/widget_quick_add_label" />
    </LinearLayout>

</FrameLayout>
